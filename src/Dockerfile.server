# syntax=docker/dockerfile:1
#
# Server image for the "neo4gen" Fly.io app. Multi-stage build that reproduces what the Aspire
# AppHost does at publish time (server.PublishWithContainerFiles(webfrontend, "wwwroot")):
#   1. build the Vite SPA (baking in the copilot-runtime's public URL),
#   2. publish the .NET server,
#   3. fold the SPA's dist into the server's wwwroot (served by app.UseFileServer()).
# Build context is the repo's src/ directory.

# --- Stage 1: build the Vite SPA ---
FROM oven/bun:1 AS frontend
WORKDIR /app/frontend
COPY frontend/package.json frontend/bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile
COPY frontend/ ./
# Compiled into the SPA at build time, so it must be the *public* Fly URL of the copilot runtime.
ARG VITE_COPILOTKIT_RUNTIME_URL=https://neo4gen-copilot.fly.dev/api/copilotkit
ENV VITE_COPILOTKIT_RUNTIME_URL=$VITE_COPILOTKIT_RUNTIME_URL
RUN bun run build

# --- Stage 2: publish the .NET server ---
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS server-build
WORKDIR /src
COPY Neo4gen.Server/Neo4gen.Server.csproj Neo4gen.Server/
RUN dotnet restore Neo4gen.Server/Neo4gen.Server.csproj
COPY Neo4gen.Server/ Neo4gen.Server/
RUN dotnet publish Neo4gen.Server/Neo4gen.Server.csproj -c Release -o /app/publish /p:UseAppHost=false

# --- Stage 3: runtime ---
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=server-build /app/publish ./
COPY --from=frontend /app/frontend/dist ./wwwroot
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
EXPOSE 8080
ENTRYPOINT ["dotnet", "Neo4gen.Server.dll"]
